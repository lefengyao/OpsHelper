<UserControl x:Class="ServerOpsHelper.Controls.SecretBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <PasswordBox x:Name="PasswordInput"
                     Grid.Column="0"
                     VerticalContentAlignment="Center"
                     PasswordChanged="PasswordInput_PasswordChanged" />

        <!-- 勾选「显示」时改用普通文本框显示明文，方便核对有没有打错 -->
        <TextBox x:Name="PasswordRevealed"
                 Grid.Column="0"
                 Visibility="Collapsed"
                 VerticalContentAlignment="Center"
                 TextChanged="PasswordRevealed_TextChanged" />

        <CheckBox x:Name="RevealCheckBox"
                  Grid.Column="1"
                  Content="显示"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  Checked="RevealCheckBox_Changed"
                  Unchecked="RevealCheckBox_Changed" />
    </Grid>
</UserControl>
