<Page x:Class="ServerOpsHelper.Views.ServerDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:local="clr-namespace:ServerOpsHelper.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="服务器详情">

    <!--
        2026-10-01 三期改造（对齐 FinalShell 的服务器工作台）：
          一期：终端换成 xterm.js 真终端（SSH.NET ShellStream PTY）；
          二期：下半部分加 SFTP 文件面板；
          三期：左侧加实时监控栏（CPU/内存/磁盘/网络/负载）。
        三条独立 SSH 连接：终端（shell）、文件（sftp）、监控（周期采集），互不阻塞。
        终端与文件区之间的分隔条可拖拽。
    -->
    <Grid Margin="16,12,16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="140" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   x:Name="TitleTextBlock"
                   Text="服务器详情"
                   Style="{StaticResource HeaderTextBlockStyle}"
                   Margin="0,0,0,4" />

        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:SimpleStackPanel Grid.Column="0"
                                 Spacing="12"
                                 VerticalAlignment="Center"
                                 Orientation="Horizontal">
                <TextBlock x:Name="HostTextBlock" Opacity="0.85" />
                <TextBlock x:Name="OsTypeTextBlock" Opacity="0.85" />
                <TextBlock x:Name="DescriptionTextBlock"
                           TextWrapping="Wrap" Opacity="0.6"
                           MaxWidth="420" TextTrimming="CharacterEllipsis" />
            </ui:SimpleStackPanel>

            <!-- 扩展动作：用户自己在 extensions/*.json 里加的常用命令。
                 没装扩展时整块隐藏，不占地方。 -->
            <ui:SimpleStackPanel x:Name="ExtensionActionPanel"
                                 Grid.Column="1"
                                 Spacing="8"
                                 VerticalAlignment="Center"
                                 Orientation="Horizontal"
                                 Visibility="Collapsed">
                <ComboBox x:Name="ExtensionCommandComboBox"
                          Width="200"
                          DisplayMemberPath="DisplayName" />
                <Button x:Name="RunExtensionButton"
                        Content="执行"
                        Click="RunExtensionButton_Click" />
            </ui:SimpleStackPanel>
        </Grid>

        <!-- 左侧：实时监控（跨终端/分隔条/文件面板三行） -->
        <local:ServerMonitorPanel Grid.Row="2" Grid.RowSpan="3" Grid.Column="0"
                                  x:Name="MonitorPanel"
                                  Margin="0,0,12,0" />

        <!-- 右上：SSH 终端 -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="#14181d"
                CornerRadius="6"
                ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="TerminalWebView"
                              DefaultBackgroundColor="Transparent" />
                <!-- 终端起不来时的兜底提示（WebView2 初始化失败 / 资源缺失） -->
                <TextBlock x:Name="TerminalHintTextBlock"
                           Foreground="#d8dee9"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3" Grid.Column="1"
                      Height="8"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      ToolTip="拖动调整终端与文件区的高度" />

        <!-- 右下：SFTP 文件面板 -->
        <local:SftpFilePanel Grid.Row="4" Grid.Column="1" x:Name="FilePanel" />
    </Grid>
</Page>
