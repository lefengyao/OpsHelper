<Page x:Class="ServerOpsHelper.Views.FrpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:controls="clr-namespace:ServerOpsHelper.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="FRP 穿透">

    <Page.Resources>
        <!-- 与设置页同一套页签样式：四个面板全实例化、只切 Visibility，
             这样 FindName / 探针始终能找到控件（不用 TabControl 的原因同设置页） -->
        <Style x:Key="FrpNavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Margin="0,0,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ContentPresenter Grid.Row="0"
                                              Margin="14,9,14,9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />

                            <Border x:Name="Indicator"
                                    Grid.Row="1"
                                    Height="3"
                                    CornerRadius="1.5"
                                    Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                    Opacity="0" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片：概览页的几块内容用同一套边框，避免每处重复写 -->
        <Style x:Key="FrpCardStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- 表单里的字段小标题；不能在这里 Setter Property="Style"（Style 里套 Style 会抛） -->
        <Style x:Key="FrpFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Page.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ───────────── 标题 + 状态 + 启动/停止 ───────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="FRP 穿透"
                       Style="{StaticResource HeaderTextBlockStyle}"
                       VerticalAlignment="Center" />

            <ui:SimpleStackPanel Orientation="Horizontal"
                                 Spacing="12"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center">
                <TextBlock x:Name="FrpStatusTextBlock"
                           VerticalAlignment="Center"
                           Opacity="0.85" />
                <Button x:Name="FrpStartStopButton"
                        Content="启动"
                        MinWidth="88"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="StartStop_Click" />
            </ui:SimpleStackPanel>
        </Grid>

        <!-- ───────────── 工具条：模式 / 配置档案 ───────────── -->
        <Border Grid.Row="1"
                Style="{StaticResource FrpCardStyle}"
                Padding="12,8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="模式"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Grid.Column="1"
                          x:Name="FrpModeComboBox"
                          Width="96"
                          SelectionChanged="Mode_Changed" />

                <TextBlock Grid.Column="2"
                           Text="配置档案"
                           VerticalAlignment="Center"
                           Margin="20,0,8,0" />
                <ComboBox Grid.Column="3"
                          x:Name="FrpProfileComboBox"
                          Width="150"
                          SelectionChanged="Profile_Changed" />

                <ui:SimpleStackPanel Grid.Column="4"
                                     Orientation="Horizontal"
                                     Spacing="6"
                                     Margin="10,0,0,0">
                    <Button Content="新建" Click="NewProfile_Click" Padding="10,4" />
                    <Button Content="重命名" Click="RenameProfile_Click" Padding="10,4" />
                    <Button Content="删除" Click="DeleteProfile_Click" Padding="10,4" />
                </ui:SimpleStackPanel>

                <TextBlock Grid.Column="5"
                           x:Name="FrpRunningHintTextBlock"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Opacity="0.65"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- ───────────── 子页签 ───────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="NavFrpOverview" Content="概览" Tag="Overview" GroupName="FrpNav"
                         IsChecked="True" Style="{StaticResource FrpNavItemStyle}" Checked="Nav_Checked" />
            <RadioButton x:Name="NavFrpRules" Content="转发规则" Tag="Rules" GroupName="FrpNav"
                         Style="{StaticResource FrpNavItemStyle}" Checked="Nav_Checked" />
            <RadioButton x:Name="NavFrpServer" Content="服务器配置" Tag="Server" GroupName="FrpNav"
                         Style="{StaticResource FrpNavItemStyle}" Checked="Nav_Checked" />
            <RadioButton x:Name="NavFrpLogs" Content="运行日志" Tag="Logs" GroupName="FrpNav"
                         Style="{StaticResource FrpNavItemStyle}" Checked="Nav_Checked" />
        </StackPanel>

        <Grid Grid.Row="3">
            <!-- ═══════════ 概览 ═══════════ -->
            <ScrollViewer x:Name="PanelFrpOverview"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="920" HorizontalAlignment="Stretch">

                    <Border Style="{StaticResource FrpCardStyle}">
                        <StackPanel>
                            <TextBlock Text="运行状态" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="当前模式" Opacity="0.7" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OvModeTextBlock" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="进程" Opacity="0.7" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OvPidTextBlock" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="运行时长" Opacity="0.7" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OvUptimeTextBlock" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="配置文件" Opacity="0.7" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           x:Name="OvConfigPathTextBlock"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowDuration="30000" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FrpCardStyle}">
                        <StackPanel>
                            <TextBlock Text="待启动的配置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="配置档案" Opacity="0.7" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OvProfileTextBlock" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="目标 / 监听" Opacity="0.7" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OvTargetTextBlock" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="转发规则" Opacity="0.7" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OvRuleCountTextBlock" />
                            </Grid>

                            <TextBlock x:Name="OvWarnTextBlock"
                                       Foreground="#c4553d"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Visibility="Collapsed" />

                            <TextBlock Text="改完配置或规则后要停止再启动才会生效。"
                                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FrpCardStyle}">
                        <StackPanel>
                            <TextBlock Text="FRP 环境" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                            <TextBlock Text="frpc / frps 所在目录"
                                       Style="{StaticResource FrpFieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" x:Name="FrpDirTextBox" />
                                <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseFrpDir_Click" />
                                <Button Grid.Column="2" Content="自动定位" Margin="8,0,0,0" Click="AutoLocateFrpDir_Click" />
                            </Grid>

                            <TextBlock x:Name="FrpDirHintTextBlock"
                                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />

                            <TextBlock Text="目录里要直接有 frpc.exe 或 frps.exe；frp\win-x64 这种子目录布局，请填到 win-x64 那一层。"
                                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />

                            <Button Content="应用目录"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    Click="ApplyFrpDir_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FrpCardStyle}">
                        <StackPanel>
                            <TextBlock Text="frp 版本 / 安装更新" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="已安装" Opacity="0.7" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VerCurrentTextBlock" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="推荐稳定版" Opacity="0.7" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VerStableTextBlock" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="最新版本" Opacity="0.7" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="VerLatestTextBlock" />
                            </Grid>

                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                <Button Content="检查更新" Click="CheckVersion_Click" />
                                <Button Content="安装 / 切到稳定版" Click="InstallFrp_Click" Tag="stable" />
                                <Button Content="安装最新版" Click="InstallFrp_Click" Tag="latest" />
                            </ui:SimpleStackPanel>

                            <TextBlock x:Name="VerHintTextBlock"
                                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════ 转发规则 ═══════════ -->
            <Grid x:Name="PanelFrpRules" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="规则保存在当前配置档案的 frpc.toml 里，改完立即写盘。"
                               Style="{StaticResource ItemCaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <DataGrid Grid.Row="1"
                              x:Name="RulesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionChanged="RulesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="70" />
                            <DataGridTextColumn Header="本地服务" Binding="{Binding LocalTarget}" Width="150" />
                            <DataGridTextColumn Header="远端映射" Binding="{Binding RemoteTarget}" Width="*" MinWidth="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <ui:SimpleStackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="＋ 添加" Click="AddRule_Click" />
                        <Button Content="删除选中" Click="DeleteRule_Click" />
                        <Button Content="重新加载" Click="ReloadRules_Click" />
                    </ui:SimpleStackPanel>
                </Grid>

                <Border Grid.Column="1" Style="{StaticResource FrpCardStyle}" Margin="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="RuleEditorTitleTextBlock"
                                       Text="规则详情"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="名称" Style="{StaticResource FrpFieldLabelStyle}" />
                            <TextBox x:Name="RuleNameTextBox" />

                            <TextBlock Text="转发类型" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                            <ComboBox x:Name="RuleTypeComboBox"
                                      SelectionChanged="RuleType_Changed" />

                            <TextBlock Text="本地服务 IP" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                            <TextBox x:Name="RuleLocalIpTextBox" />

                            <TextBlock Text="本地端口" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                            <TextBox x:Name="RuleLocalPortTextBox" />

                            <StackPanel x:Name="RuleRemotePortPanel">
                                <TextBlock Text="远程端口" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                                <TextBox x:Name="RuleRemotePortTextBox" />
                            </StackPanel>

                            <StackPanel x:Name="RuleDomainsPanel" Visibility="Collapsed">
                                <TextBlock Text="域名（逗号分隔）" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                                <TextBox x:Name="RuleDomainsTextBox" />
                            </StackPanel>

                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                                <Button Content="应用并保存" Click="ApplyRule_Click" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="取消" Click="CancelRule_Click" />
                            </ui:SimpleStackPanel>

                            <TextBlock x:Name="RuleHintTextBlock"
                                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ═══════════ 服务器配置 ═══════════ -->
            <ScrollViewer x:Name="PanelFrpServer"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">

                    <Border Style="{StaticResource FrpCardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="SrvTitleTextBlock"
                                           Text="服务器连接"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <CheckBox x:Name="SrvTextModeCheck"
                                          Content="文本模式"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          Checked="SrvTextMode_Changed"
                                          Unchecked="SrvTextMode_Changed" />
                            </Grid>

                            <TextBlock x:Name="SrvPathTextBlock"
                                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,12" />

                            <!-- 表单模式 -->
                            <StackPanel x:Name="SrvFormPanel">
                                <!-- frpc -->
                                <StackPanel x:Name="FrpcFormPanel">
                                    <TextBlock Text="服务器地址" Style="{StaticResource FrpFieldLabelStyle}" />
                                    <TextBox x:Name="SrvAddrTextBox" />

                                    <TextBlock Text="服务器端口" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                                    <TextBox x:Name="SrvPortTextBox" />

                                    <TextBlock Text="认证 Token" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                                    <controls:SecretBox x:Name="SrvTokenBox" />

                                    <TextBlock Text="传输协议" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                                    <ComboBox x:Name="SrvProtocolComboBox" />
                                </StackPanel>

                                <!-- frps -->
                                <StackPanel x:Name="FrpsFormPanel" Visibility="Collapsed">
                                    <TextBlock Text="监听地址" Style="{StaticResource FrpFieldLabelStyle}" />
                                    <TextBox x:Name="SrvBindAddrTextBox" />

                                    <TextBlock Text="监听端口" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                                    <TextBox x:Name="SrvBindPortTextBox" />

                                    <TextBlock Text="认证 Token" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                                    <controls:SecretBox x:Name="SrvServerTokenBox" />

                                    <TextBlock Text="传输协议" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                                    <ComboBox x:Name="SrvServerProtocolComboBox" />

                                    <TextBlock Text="面板地址" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,16,0,4" />
                                    <TextBox x:Name="SrvWebAddrTextBox" />

                                    <TextBlock Text="面板端口" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                                    <TextBox x:Name="SrvWebPortTextBox" />

                                    <TextBlock Text="面板账号" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                                    <TextBox x:Name="SrvWebUserTextBox" />

                                    <TextBlock Text="面板密码" Style="{StaticResource FrpFieldLabelStyle}" Margin="0,12,0,4" />
                                    <controls:SecretBox x:Name="SrvWebPasswordBox" />
                                </StackPanel>

                                <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                                    <Button Content="保存配置" Style="{StaticResource AccentButtonStyle}" Click="SaveServer_Click" />
                                    <Button Content="重新加载" Click="ReloadServer_Click" />
                                </ui:SimpleStackPanel>
                            </StackPanel>

                            <!-- 文本模式 -->
                            <StackPanel x:Name="SrvTextPanel" Visibility="Collapsed">
                                <TextBox x:Name="SrvTextEditor"
                                         AcceptsReturn="True"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Height="380"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap" />

                                <ui:SimpleStackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                    <Button Content="保存 TOML" Style="{StaticResource AccentButtonStyle}" Click="SaveServerText_Click" />
                                    <Button Content="重新加载" Click="ReloadServer_Click" />
                                </ui:SimpleStackPanel>

                                <TextBlock Text="这里改的是原始文件，写坏了 frp 会起不来；不确定就先切回表单模式保存一次生成合法内容。"
                                           Style="{StaticResource ItemCaptionTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════ 运行日志 ═══════════ -->
            <Grid x:Name="PanelFrpLogs" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:SimpleStackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                    <Button Content="清空日志" Click="ClearLogs_Click" />
                    <CheckBox x:Name="FrpLogAutoScrollCheck"
                              Content="自动滚动"
                              IsChecked="True"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="LogCountTextBlock"
                               VerticalAlignment="Center"
                               Opacity="0.65" />
                </ui:SimpleStackPanel>

                <Border Grid.Row="1"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        CornerRadius="6"
                        Background="#101418">
                    <ListBox x:Name="FrpLogListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"
                                           Foreground="{Binding Foreground}"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
