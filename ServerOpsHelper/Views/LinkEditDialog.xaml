<ui:ContentDialog x:Class="ServerOpsHelper.Views.LinkEditDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.modernwpf.com/2019"
                  xmlns:controls="clr-namespace:ServerOpsHelper.Controls"
                  Title="新增链接">

    <ScrollViewer MaxHeight="480"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <!-- 右侧留出滚动条的宽度：ModernWpf 的滚动条是浮在内容上的，不留空隙会压住输入框右边框 -->
        <StackPanel Width="440" Margin="0,0,16,0">
            <TextBlock Text="名称" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="NameTextBox"
                     Margin="0,4,0,12"
                     TextChanged="Field_TextChanged" />

            <TextBlock Text="类型" Style="{StaticResource CaptionTextBlockStyle}" />
            <ComboBox x:Name="KindComboBox"
                      Margin="0,4,0,12">
                <ComboBoxItem Content="常用网页" />
                <ComboBoxItem Content="宝塔面板（专用链接）" />
            </ComboBox>

            <!-- ── 宝塔面板专用字段 ── -->
            <StackPanel x:Name="BtPanelSection" Visibility="Collapsed">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="服务器地址 / IP" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox x:Name="HostTextBox" TextChanged="Field_TextChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="端口" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox x:Name="PortTextBox" Width="90" Text="8888" TextChanged="Field_TextChanged" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="安全入口（面板地址最后一段随机字符串，可留空）"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBox x:Name="SafeEntryTextBox"
                         Margin="0,4,0,8"
                         TextChanged="Field_TextChanged" />

                <Button Content="由「IP / 端口 / 安全入口」生成地址"
                        Margin="0,0,0,12"
                        Click="BuildUrlButton_Click" />
            </StackPanel>

            <TextBlock Text="地址（完整 URL）" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="UrlTextBox"
                     Margin="0,4,0,12"
                     TextChanged="Field_TextChanged" />

            <TextBlock Text="账号" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="UsernameTextBox"
                     Margin="0,4,0,12"
                     TextChanged="Field_TextChanged" />

            <TextBlock Text="密码（Windows DPAPI 加密后保存）" Style="{StaticResource CaptionTextBlockStyle}" />
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:SecretBox x:Name="PasswordInput"
                                    Grid.Column="0"
                                    PasswordChanged="SecretBox_PasswordChanged" />

                <Button Grid.Column="1"
                        Content="生成"
                        Margin="8,0,0,0"
                        Click="GeneratePasswordButton_Click" />
            </Grid>

            <TextBlock Text="标签（逗号分隔，可选）" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="TagsTextBox"
                     Margin="0,4,0,12"
                     TextChanged="Field_TextChanged" />

            <TextBlock Text="备注" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="NotesTextBox"
                     Margin="0,4,0,12"
                     AcceptsReturn="True"
                     Height="64"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="Field_TextChanged" />

            <CheckBox x:Name="PinnedCheckBox" Content="置顶显示" />

            <TextBlock x:Name="HintTextBlock"
                       Foreground="#D13438"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ui:ContentDialog>
