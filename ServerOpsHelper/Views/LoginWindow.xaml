<Window x:Class="ServerOpsHelper.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="登录 - 服务器运维助手"
        Icon="pack://application:,,,/ServerOpsHelper;component/Assets/appicon.ico"
        Width="380"
        Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <!-- HeaderTextBlockStyle 是 46px，在 380 宽的登录窗里会折成两行，这里压到 28 -->
            <TextBlock Text="服务器运维助手"
                       Style="{StaticResource HeaderTextBlockStyle}"
                       FontSize="28"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Server Ops Helper"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 表单区 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="账号" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="UsernameTextBox"
                     Margin="0,4,0,16"
                     Text="admin"
                     VerticalContentAlignment="Center" />

            <TextBlock Text="密码" Style="{StaticResource CaptionTextBlockStyle}" />
            <PasswordBox x:Name="PasswordBox"
                         Margin="0,4,0,24"
                         VerticalContentAlignment="Center" />

            <Button Content="登 录"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="LoginButton_Click"
                    IsDefault="True" />

            <TextBlock x:Name="ErrorTextBlock"
                       Foreground="#D13438"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- 底部提示：仅首次运行（尚未创建账号）时显示 -->
        <TextBlock x:Name="DefaultAccountHintTextBlock"
                   Grid.Row="2"
                   Text="首次运行默认账号：admin / admin123"
                   FontSize="12"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                   HorizontalAlignment="Center" />
    </Grid>
</Window>
