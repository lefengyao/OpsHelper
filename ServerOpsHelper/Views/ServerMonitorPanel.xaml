<UserControl x:Class="ServerOpsHelper.Views.ServerMonitorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
        服务器监控面板（三期）：对齐 FinalShell 左侧那栏。
        数据由 RemoteMonitorService 每 3 秒采集一次（一条聚合命令拿全部指标），
        这里只负责把指标画出来。
    -->
    <Border BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            CornerRadius="6"
            Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ui:SimpleStackPanel Spacing="12">

                <TextBlock Text="系统监控" FontWeight="SemiBold" FontSize="13" />

                <!-- 基本信息 -->
                <ui:SimpleStackPanel Spacing="3">
                    <TextBlock x:Name="HostTextBlock" FontSize="12"
                               TextTrimming="CharacterEllipsis" Text="—" />
                    <TextBlock x:Name="OsTextBlock" FontSize="11" Opacity="0.7"
                               TextWrapping="Wrap" Text="—" />
                    <Grid>
                        <TextBlock Text="运行" FontSize="11" Opacity="0.7" />
                        <TextBlock x:Name="UptimeTextBlock" FontSize="11" Opacity="0.7"
                                   HorizontalAlignment="Right" Text="—" />
                    </Grid>
                </ui:SimpleStackPanel>

                <!-- CPU -->
                <ui:SimpleStackPanel Spacing="3">
                    <Grid>
                        <TextBlock Text="CPU" FontSize="12" />
                        <TextBlock x:Name="CpuTextBlock" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Text="—" />
                    </Grid>
                    <ProgressBar x:Name="CpuBar" Height="6" Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="LoadTextBlock" FontSize="11" Opacity="0.7"
                               TextTrimming="CharacterEllipsis" Text="负载 —" />
                </ui:SimpleStackPanel>

                <!-- 内存 -->
                <ui:SimpleStackPanel Spacing="3">
                    <Grid>
                        <TextBlock Text="内存" FontSize="12" />
                        <TextBlock x:Name="MemTextBlock" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Text="—" />
                    </Grid>
                    <ProgressBar x:Name="MemBar" Height="6" Minimum="0" Maximum="100" Value="0" />
                </ui:SimpleStackPanel>

                <!-- 磁盘 -->
                <ui:SimpleStackPanel Spacing="3">
                    <Grid>
                        <TextBlock Text="磁盘 /" FontSize="12" />
                        <TextBlock x:Name="DiskTextBlock" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Text="—" />
                    </Grid>
                    <ProgressBar x:Name="DiskBar" Height="6" Minimum="0" Maximum="100" Value="0" />
                </ui:SimpleStackPanel>

                <!-- 网络 -->
                <ui:SimpleStackPanel Spacing="3">
                    <TextBlock x:Name="NetTitleTextBlock" FontSize="12" Text="网络" />
                    <Grid>
                        <TextBlock Text="↓ 下载" FontSize="11" Opacity="0.7" />
                        <TextBlock x:Name="NetRxTextBlock" FontSize="11"
                                   HorizontalAlignment="Right" Text="—" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="↑ 上传" FontSize="11" Opacity="0.7" />
                        <TextBlock x:Name="NetTxTextBlock" FontSize="11"
                                   HorizontalAlignment="Right" Text="—" />
                    </Grid>
                </ui:SimpleStackPanel>

                <TextBlock x:Name="StatusTextBlock"
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           Text="正在采集…" />
            </ui:SimpleStackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
