<Page x:Class="ServerOpsHelper.Views.BookmarksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="常用链接">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 统计 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="常用链接"
                       Style="{StaticResource HeaderTextBlockStyle}" />
            <TextBlock Text="保存经常访问的后台网页与宝塔面板专用链接。列表按「置顶 → 打开次数」排序，越常用的越靠前。"
                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding SummaryText}"
                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:AutoSuggestBox Grid.Column="0"
                               x:Name="SearchBox"
                               PlaceholderText="搜索名称、地址、账号或标签"
                               QueryIcon="Find"
                               Width="320"
                               HorizontalAlignment="Left"
                               Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:AppBarButton Icon="Refresh"
                                 Label="刷新"
                                 Click="RefreshButton_Click" />
                <ui:AppBarButton Icon="Add"
                                 Label="新增网页"
                                 Click="AddWebButton_Click" />
                <ui:AppBarButton Icon="Add"
                                 Label="新增宝塔"
                                 Click="AddBtButton_Click" />
            </StackPanel>
        </Grid>

        <!-- 数据列表 -->
        <Grid Grid.Row="2">
            <ui:ListView x:Name="LinkListView"
                         ItemsSource="{Binding Links}"
                         SelectionMode="Single">
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 类型图标：网页 / 宝塔面板 -->
                            <Viewbox Grid.Column="0"
                                     Width="30"
                                     Height="30"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Top">
                                <TextBlock Text="{Binding Kind, Converter={StaticResource LinkKindToIconConverter}}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="24" />
                            </Viewbox>

                            <!-- 主要信息 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource ItemTitleTextBlockStyle}" />

                                    <Border Margin="8,0,0,0"
                                            Padding="6,1"
                                            CornerRadius="9"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="置顶"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding DisplayAddress}"
                                           Style="{StaticResource ItemCaptionTextBlockStyle}" />
                                <TextBlock Text="{Binding MetaText}"
                                           Style="{StaticResource ItemCaptionTextBlockStyle}" />
                            </StackPanel>

                            <!-- 行内操作 -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="打开"
                                        FontSize="12"
                                        Padding="10,4"
                                        Margin="0,0,6,0"
                                        Tag="{Binding}"
                                        Click="OpenInConsoleButton_Click"
                                        ToolTip="在应用内置的 Web 控制台中打开" />
                                <Button Content="浏览器"
                                        FontSize="12"
                                        Padding="10,4"
                                        Margin="0,0,6,0"
                                        Tag="{Binding}"
                                        Click="OpenInBrowserButton_Click"
                                        ToolTip="用系统默认浏览器打开" />
                                <Button Content="复制"
                                        FontSize="12"
                                        Padding="10,4"
                                        Margin="0,0,6,0"
                                        Tag="{Binding}"
                                        Click="CopyButton_Click"
                                        ToolTip="复制登录信息（地址 / 账号 / 密码）" />
                                <Button Content="编辑"
                                        FontSize="12"
                                        Padding="10,4"
                                        Margin="0,0,6,0"
                                        Tag="{Binding}"
                                        Click="EditButton_Click" />
                                <Button Content="删除"
                                        FontSize="12"
                                        Padding="10,4"
                                        Tag="{Binding}"
                                        Click="DeleteButton_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <!-- 空状态提示 -->
            <TextBlock Text="{Binding EmptyHint}"
                       Width="420"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Page>
