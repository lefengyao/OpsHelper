<Window x:Class="ServerOpsHelper.Views.DownloadManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载管理"
        Width="640"
        Height="420"
        MinWidth="480"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 下载目录 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="下载管理"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="DirectoryTextBlock"
                       Margin="0,4,0,0"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <!-- 下载列表 -->
        <ListView x:Name="DownloadList"
                  Grid.Row="1"
                  BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,10" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 文件名 + 危险标记 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding FileName}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="⚠ 可执行文件"
                                       Margin="8,0,0,0"
                                       FontSize="11"
                                       Foreground="OrangeRed"
                                       Visibility="{Binding IsSuspicious, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- 状态 + 大小 -->
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

                        <!-- 进度条 -->
                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Height="6"
                                     Margin="0,6,0,0"
                                     Value="{Binding Progress}"
                                     Minimum="0"
                                     Maximum="100"
                                     Visibility="{Binding IsFinished, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                        <!-- 详情行：大小 + 路径 + 操作 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                    Margin="0,6,0,0"
                                    Orientation="Horizontal">
                            <TextBlock Text="{Binding SizeText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBlock Text="{Binding TargetPath}"
                                       Margin="10,0,0,0"
                                       FontSize="11"
                                       MaxWidth="380"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <Button Content="定位文件"
                                    Margin="10,-3,0,0"
                                    Padding="8,2"
                                    FontSize="11"
                                    Click="RevealButton_Click"
                                    Tag="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="打开下载目录"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    Click="OpenDirButton_Click" />
            <Button Content="清空已完成"
                    Padding="14,6"
                    Click="ClearButton_Click" />
        </StackPanel>
    </Grid>
</Window>
