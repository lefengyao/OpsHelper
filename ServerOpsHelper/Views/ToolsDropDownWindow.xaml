<Window x:Class="ServerOpsHelper.Views.ToolsDropDownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工具"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <!--
        ☰ 工具下拉窗（竖排菜单，贴着 ☰ 按钮弹出）。
        之所以是独立窗口而不是 Popup / 窗口内浮层：WebView2 是原生子窗口，
        按 Windows 规则永远画在 WPF 内容之上，任何「画在窗口里的浮层」都会被网页盖住。
        独立顶层窗口在 z 序里必然压在子窗口之上 —— 和 CredentialCaptureWindow 同一个道理。
        失焦即关（见代码里的 Deactivated），行为与浏览器菜单一致。
    -->
    <Border Margin="8"
            CornerRadius="8"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            Padding="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              ShadowDepth="2"
                              Opacity="0.32" />
        </Border.Effect>

        <StackPanel Width="268">
            <!-- 页面操作 -->
            <TextBlock Text="页面操作"
                       Margin="10,4,10,4"
                       FontSize="11.5"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Button Style="{StaticResource DropMenuItemButton}"
                    Content="填充账号密码"
                    Click="Fill_Click"
                    ToolTip="优先用当前链接记录的账号密码；没有关联记录时，按站点去密码箱里找" />
            <Button Style="{StaticResource DropMenuItemButton}"
                    x:Name="OpenPanelToggle"
                    Content="打开…"
                    Click="Recent_Click"
                    ToolTip="从最近访问过的页面 / 常用链接 / 历史记录里挑一个打开" />
            <Button Style="{StaticResource DropMenuItemButton}"
                    Content="收藏当前页"
                    Click="Bookmark_Click" />
            <Button Style="{StaticResource DropMenuItemButton}"
                    Content="收藏夹管理"
                    Click="BookmarksPage_Click"
                    ToolTip="打开常用链接 / 收藏夹管理页（增删改查、在控制台或系统浏览器打开）" />
            <Button Style="{StaticResource DropMenuItemButton}"
                    Content="浏览记录"
                    Click="HistoryPage_Click"
                    ToolTip="打开访问记录页（按时间列出访问过的页面，可单条删除或清空）" />

            <Separator Margin="6,8,6,4" />

            <!-- 浏览数据 / 下载 / 扩展 -->
            <TextBlock Text="浏览数据"
                       Margin="10,2,10,4"
                       FontSize="11.5"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Button Style="{StaticResource DropMenuItemButton}"
                    Content="下载管理"
                    Click="Downloads_Click"
                    ToolTip="查看下载进度、打开下载文件、清空记录" />
            <Button Style="{StaticResource DropMenuItemButton}"
                    Content="清除浏览数据"
                    Click="ClearData_Click"
                    ToolTip="清除 Cookie / 缓存等站内浏览数据（登录态会失效）" />
            <Button Style="{StaticResource DropMenuItemButton}"
                    Content="浏览器扩展"
                    Click="Extensions_Click"
                    ToolTip="安装 / 启用 / 禁用 / 删除 Edge 浏览器插件" />

            <Separator Margin="6,8,6,4" />

            <!-- 缩放 -->
            <TextBlock Text="缩放"
                       Margin="10,2,10,4"
                       FontSize="11.5"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Grid Margin="8,0,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          x:Name="ZoomComboBox">
                    <ComboBoxItem Content="适应宽度" />
                    <ComboBoxItem Content="50%" />
                    <ComboBoxItem Content="75%" />
                    <ComboBoxItem Content="100%" />
                    <ComboBoxItem Content="125%" />
                    <ComboBoxItem Content="150%" />
                    <ComboBoxItem Content="200%" />
                </ComboBox>
                <Button Grid.Column="1"
                        Style="{StaticResource DropMenuItemButton}"
                        Content="重新适配"
                        Margin="8,0,0,0"
                        Padding="10,6"
                        Click="Fit_Click"
                        ToolTip="按页面内容宽度重新计算缩放，让网页横向铺满可视区域" />
            </Grid>

            <Separator Margin="6,4,6,4" />

            <!-- 网页视觉辅助 -->
            <TextBlock Text="网页视觉辅助"
                       Margin="10,2,10,4"
                       FontSize="11.5"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <CheckBox x:Name="FillAidToggle"
                      Margin="10,0,8,4"
                      Content="填充后高亮输入框"
                      Checked="Aid_Changed"
                      Unchecked="Aid_Changed" />
            <TextBlock Text="自动填充账号密码后，在网页里高亮闪烁被填的输入框，约 2 秒后消失"
                       Margin="10,0,10,4"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>
    </Border>
</Window>
