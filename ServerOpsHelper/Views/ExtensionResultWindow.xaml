<Window x:Class="ServerOpsHelper.Views.ExtensionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="执行结果"
        Width="760"
        Height="520"
        MinWidth="520"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:SimpleStackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderTextBlock"
                       Style="{StaticResource SubheaderTextBlockStyle}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="StatusTextBlock"
                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                       TextWrapping="Wrap" />
        </ui:SimpleStackPanel>

        <TextBox x:Name="OutputTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" />

        <ui:SimpleStackPanel Grid.Row="2"
                             Orientation="Horizontal"
                             Spacing="8"
                             Margin="0,10,0,0"
                             HorizontalAlignment="Right">
            <Button Content="复制全部" Click="CopyButton_Click" />
            <Button Content="关闭" IsCancel="True" IsDefault="True" Click="CloseButton_Click" />
        </ui:SimpleStackPanel>
    </Grid>
</Window>
