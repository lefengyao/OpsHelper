<Window x:Class="ServerOpsHelper.Views.CredentialCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:controls="clr-namespace:ServerOpsHelper.Controls"
        Title="保存到密码箱"
        Icon="pack://application:,,,/ServerOpsHelper;component/Assets/appicon.ico"
        Width="520"
        Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">

    <!--
        ⚠️ 这里刻意用「独立窗口」而不是 ModernWpf 的 ContentDialog：
        内置浏览器（WebView2）是 HwndHost 原生子窗口，永远画在窗口内的 WPF 内容之上，
        而 ContentDialog 是画在窗口里的浮层 —— 用它就会变成"对话框跑到网页后面去"。
        独立顶层窗口在 Windows 的 z 序里必然压在子窗口之上，这是平台保证的。
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="保存到密码箱" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="IntroTextBlock"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- 右侧留出滚动条宽度：ModernWpf 的滚动条浮在内容上，不留空隙会压住输入框 -->
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="名称" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBox x:Name="TitleTextBox"
                         Margin="0,4,0,12"
                         TextChanged="Field_TextChanged" />

                <TextBlock Text="分类（可选，默认用站点域名）" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBox x:Name="CategoryTextBox"
                         Margin="0,4,0,12"
                         TextChanged="Field_TextChanged" />

                <TextBlock Text="账号" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBox x:Name="UsernameTextBox"
                         Margin="0,4,0,12"
                         TextChanged="Field_TextChanged" />

                <TextBlock Text="密码（Windows DPAPI 加密后保存）" Style="{StaticResource CaptionTextBlockStyle}" />
                <controls:SecretBox x:Name="PasswordInput"
                                    Margin="0,4,0,12"
                                    PasswordChanged="SecretBox_PasswordChanged" />

                <TextBlock Text="登录地址" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBox x:Name="UrlTextBox"
                         Margin="0,4,0,12"
                         TextChanged="Field_TextChanged" />

                <TextBlock x:Name="HintTextBlock"
                           Foreground="#D13438"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="不再提示此站点"
                    Margin="0,0,8,0"
                    Click="IgnoreSite_Click" />
            <Button Content="稍后"
                    Margin="0,0,8,0"
                    Click="Later_Click" />
            <Button x:Name="SaveButton"
                    Content="保存到密码箱"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
