<UserControl x:Class="ServerOpsHelper.Views.SftpFilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!--
        SFTP 文件面板（二期）：独立成一个 UserControl，页面只管摆放。
        浏览 + 上传/下载/删除/重命名/新建文件夹，走独立的 SFTP 连接，
        与终端的 shell 通道互不阻塞。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具条：路径 + 操作 -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="文件"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />

            <TextBox Grid.Column="1"
                     x:Name="PathTextBox"
                     VerticalContentAlignment="Center"
                     KeyDown="PathTextBox_KeyDown"
                     ToolTip="远端路径，回车跳转" />

            <ui:SimpleStackPanel Grid.Column="2"
                                 Orientation="Horizontal"
                                 Spacing="6"
                                 Margin="10,0,0,0">
                <Button Content="上级" Click="GoUp_Click" ToolTip="返回上一级目录" />
                <Button Content="刷新" Click="Refresh_Click" />
                <Button Content="上传" Click="Upload_Click" ToolTip="把本地文件上传到当前目录" />
                <Button Content="新建文件夹" Click="NewFolder_Click" />
            </ui:SimpleStackPanel>
        </Grid>

        <!-- 文件列表 -->
        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                CornerRadius="4">
            <ListView x:Name="FileListView"
                      BorderThickness="0"
                      MouseDoubleClick="FileListView_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="280"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="大小" Width="90"
                                        DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="类型" Width="70"
                                        DisplayMemberBinding="{Binding TypeText}" />
                        <GridViewColumn Header="修改时间" Width="150"
                                        DisplayMemberBinding="{Binding ModifiedText}" />
                        <GridViewColumn Header="权限" Width="110"
                                        DisplayMemberBinding="{Binding Permissions}" />
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="下载到本地…" Click="DownloadItem_Click" />
                        <MenuItem Header="重命名…" Click="RenameItem_Click" />
                        <Separator />
                        <MenuItem Header="删除" Click="DeleteItem_Click" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </Border>

        <!-- 状态行 -->
        <TextBlock Grid.Row="2"
                   x:Name="StatusTextBlock"
                   Margin="2,6,0,0"
                   FontSize="12"
                   Opacity="0.75"
                   TextTrimming="CharacterEllipsis"
                   Text="正在准备…" />
    </Grid>
</UserControl>
