<Page x:Class="ServerOpsHelper.Views.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="访问记录">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 统计 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="访问记录"
                       Style="{StaticResource HeaderTextBlockStyle}" />
            <TextBlock Text="在 Web 控制台里打开过的网页会自动记在这里。上方是本次打开应用后的页面，下方是全部历史（最多保留 300 个地址）。"
                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding SummaryText}"
                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- 本次会话 -->
        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Padding="14,12"
                CornerRadius="6"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="本次访问"
                           Style="{StaticResource ItemTitleTextBlockStyle}" />
                <TextBlock Text="{Binding SessionSummaryText}"
                           Style="{StaticResource ItemCaptionTextBlockStyle}"
                           Margin="0,2,0,10" />

                <ItemsControl ItemsSource="{Binding SessionRecords}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,8,8"
                                    Padding="10,4"
                                    FontSize="12"
                                    Tag="{Binding}"
                                    Click="OpenSessionButton_Click"
                                    ToolTip="{Binding Url}">
                                <TextBlock Text="{Binding DisplayTitle}"
                                           MaxWidth="200"
                                           TextTrimming="CharacterEllipsis" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 工具栏 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:AutoSuggestBox Grid.Column="0"
                               x:Name="SearchBox"
                               PlaceholderText="搜索标题、地址或来源链接"
                               QueryIcon="Find"
                               Width="320"
                               HorizontalAlignment="Left"
                               Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:AppBarButton Icon="Refresh"
                                 Label="刷新"
                                 Click="RefreshButton_Click" />
                <ui:AppBarButton Icon="Delete"
                                 Label="清空历史"
                                 Click="ClearButton_Click" />
            </StackPanel>
        </Grid>

        <!-- 历史列表 -->
        <Grid Grid.Row="3">
            <ui:ListView x:Name="HistoryListView"
                         ItemsSource="{Binding Records}"
                         SelectionMode="Single">
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Style="{StaticResource ItemTitleTextBlockStyle}"
                                               MaxWidth="420" />

                                    <Border Margin="8,0,0,0"
                                            Padding="6,1"
                                            CornerRadius="9"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                            Visibility="{Binding VisitedThisSession, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="本次"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Url}"
                                           Style="{StaticResource ItemCaptionTextBlockStyle}" />
                                <TextBlock Text="{Binding MetaText}"
                                           Style="{StaticResource ItemCaptionTextBlockStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0">
                                <Button Content="打开"
                                        FontSize="12"
                                        Padding="10,4"
                                        Margin="0,0,6,0"
                                        Tag="{Binding}"
                                        Click="OpenButton_Click"
                                        ToolTip="在内置 Web 控制台中打开" />
                                <Button Content="收藏"
                                        FontSize="12"
                                        Padding="10,4"
                                        Margin="0,0,6,0"
                                        Tag="{Binding}"
                                        Click="BookmarkButton_Click"
                                        ToolTip="把这条记录保存为常用链接" />
                                <Button Content="删除"
                                        FontSize="12"
                                        Padding="10,4"
                                        Tag="{Binding}"
                                        Click="DeleteButton_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <!-- 空状态提示 -->
            <TextBlock Text="{Binding EmptyHint}"
                       Width="440"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Page>
