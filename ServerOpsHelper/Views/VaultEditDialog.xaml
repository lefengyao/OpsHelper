<ui:ContentDialog x:Class="ServerOpsHelper.Views.VaultEditDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.modernwpf.com/2019"
                  xmlns:controls="clr-namespace:ServerOpsHelper.Controls"
                  Title="新增密码记录">

    <ScrollViewer MaxHeight="480"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <!-- 右侧留出滚动条的宽度：ModernWpf 的滚动条浮在内容上，不留空隙会压住输入框右边框 -->
        <StackPanel Width="440" Margin="0,0,16,0">
            <TextBlock Text="名称" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="TitleTextBox"
                     Margin="0,4,0,12"
                     TextChanged="Field_TextChanged" />

            <TextBlock Text="分类（可选，例如：云平台 / 数据库 / 后台）" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="CategoryTextBox"
                     Margin="0,4,0,12"
                     TextChanged="Field_TextChanged" />

            <TextBlock Text="账号" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="UsernameTextBox"
                     Margin="0,4,0,12"
                     TextChanged="Field_TextChanged" />

            <TextBlock Text="密码（Windows DPAPI 加密后保存）" Style="{StaticResource CaptionTextBlockStyle}" />
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:SecretBox x:Name="PasswordInput"
                                    Grid.Column="0"
                                    PasswordChanged="SecretBox_PasswordChanged" />

                <Button Grid.Column="1"
                        Content="生成"
                        Margin="8,0,0,0"
                        Click="GeneratePasswordButton_Click" />
            </Grid>

            <TextBlock Text="登录地址（可选，例如控制台 URL）" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="UrlTextBox"
                     Margin="0,4,0,12"
                     TextChanged="Field_TextChanged" />

            <TextBlock Text="备注（密保问题、绑定手机等）" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="NotesTextBox"
                     Margin="0,4,0,12"
                     AcceptsReturn="True"
                     Height="80"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="Field_TextChanged" />

            <CheckBox x:Name="PinnedCheckBox" Content="置顶显示" />

            <TextBlock x:Name="HintTextBlock"
                       Foreground="#D13438"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ui:ContentDialog>
