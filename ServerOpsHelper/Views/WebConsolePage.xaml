<UserControl x:Class="ServerOpsHelper.Views.WebConsolePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 网页占满剩余空间；提示栏放它下面（像浏览器的状态栏）-->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            ── 行0：工具栏（只留一行）──
            填充账号密码 / 注入 Token / 打开… / 收藏当前页 / 缩放 / 重新适配
            全部收进右侧 ☰ 扩展栏（默认收起），给网页腾出高度。
        -->
        <Grid Grid.Row="0" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="UrlTextBox"
                     VerticalContentAlignment="Center" />

            <Button Grid.Column="1"
                    Content="打开"
                    Margin="8,0,0,0"
                    Click="NavigateButton_Click"
                    ToolTip="在当前标签里打开地址栏里的地址" />

            <!-- 刷新：重新加载当前标签（每个标签是独立的 WebView2，只刷当前这个） -->
            <Button Grid.Column="2"
                    x:Name="RefreshButton"
                    Content="刷新"
                    Margin="6,0,0,0"
                    Click="RefreshButton_Click"
                    ToolTip="重新加载当前标签的页面（F5）" />

            <!-- ☰ 三条线：弹出竖向工具下拉窗（独立顶层窗口，不会被网页盖住） -->
            <ToggleButton Grid.Column="3"
                          x:Name="ToolsToggle"
                          Margin="8,0,0,0"
                          Width="38"
                          Click="ToolsToggle_Click"
                          ToolTip="展开 / 收起工具面板（填充账号密码、注入 Token、打开…、收藏、缩放）">
                <TextBlock Text="&#xE700;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14" />
            </ToggleButton>
        </Grid>

        <!-- ── 行1：标签栏（像普通浏览器那样，标签多了自动变窄）── -->
        <Grid Grid.Row="1" Margin="16,0,16,6">
            <!-- 用于算标签宽度的就是这一列的实际宽度，保证只跟窗口大小有关，不会因为滚动条出现而反复横跳 -->
            <Grid x:Name="TabStripHost"
                  SizeChanged="TabStripHost_SizeChanged">
                <ScrollViewer x:Name="TabStripScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TabStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        CornerRadius="6,6,0,0"
                                        Tag="{Binding}"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="Tab_Click"
                                        ToolTip="{Binding ToolTipText}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
                                                    <!-- 当前标签用主题强调色画一条下划线 -->
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayTitle}"
                                                   Margin="10,0,2,0"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Button Grid.Column="1"
                                                Content="&#xE711;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="9"
                                                Width="20"
                                                Height="20"
                                                Padding="0"
                                                Margin="0,0,4,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                VerticalAlignment="Center"
                                                Tag="{Binding}"
                                                Click="TabClose_Click"
                                                ToolTip="关闭这个标签" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── 行2：近期访问（「打开…」展开的内嵌面板；不是浮层，所以不会被网页盖住）── -->
        <Border Grid.Row="2"
                x:Name="RecentPanel"
                Margin="16,0,16,6"
                Padding="8,6"
                CornerRadius="6"
                Visibility="Collapsed"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel>
                <Grid Margin="6,0,6,4">
                    <TextBlock Text="最近访问"
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <TextBlock x:Name="RecentEmptyHint"
                               Text="暂无记录，打开一个网页后会自动记下来"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Visibility="Collapsed"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Grid>

                <ScrollViewer MaxHeight="150"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PaneLinkButtonStyle}"
                                        Tag="{Binding}"
                                        Click="RecentItem_Click"
                                        ToolTip="{Binding Subtitle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Padding="6,1"
                                                CornerRadius="9"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                            <TextBlock Text="{Binding Badge}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Subtitle}"
                                                   Margin="8,0,0,0"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ── 提示栏（放最下面，像浏览器那样；同时让标签栏直接贴着网页内容）── -->
        <TextBlock Grid.Row="4"
                   x:Name="StatusTextBlock"
                   Margin="16,6,16,8"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   Text="输入管理后台地址后点击打开。" />

        <!--
            WebView2 内容区：每个标签一个独立的 WebView2 实例，全部叠在这个容器里，
            通过 Visibility 切换当前显示的那个（切标签不重新导航，页面状态各自保留；
            某个页面白屏 / 崩溃也不连累其它标签）。容器本身基于 Grid，定位逻辑与原来一致。
            注意：WebView2 基于 HwndHost，网页是**原生子窗口**，按 Windows 规则永远画在
            窗口内的 WPF 内容之上。所以对话框一律用独立顶层窗口（见 CredentialCaptureWindow），
            ☰ 工具菜单同样是独立顶层下拉窗（见 ToolsDropDownWindow）。
        -->
        <Grid Grid.Row="3"
              x:Name="WebViewHost"
              Margin="16,0,16,0" />
    </Grid>
</UserControl>
