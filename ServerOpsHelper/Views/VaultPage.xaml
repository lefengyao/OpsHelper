<Page x:Class="ServerOpsHelper.Views.VaultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="密码箱">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 统计 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="密码箱"
                       Style="{StaticResource HeaderTextBlockStyle}" />
            <TextBlock Text="集中记录各类账号密码。密码用 Windows DPAPI（当前用户范围）加密后落盘，仅在本机本账户下可解密。"
                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding SummaryText}"
                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:AutoSuggestBox Grid.Column="0"
                               x:Name="SearchBox"
                               PlaceholderText="搜索名称、分类、账号或备注"
                               QueryIcon="Find"
                               Width="320"
                               HorizontalAlignment="Left"
                               Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:AppBarButton Icon="Refresh"
                                 Label="刷新"
                                 Click="RefreshButton_Click" />
                <ui:AppBarButton Icon="Add"
                                 Label="新增记录"
                                 Click="AddButton_Click" />
            </StackPanel>
        </Grid>

        <!-- 左列表 + 右详情 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 列表 -->
            <Grid Grid.Column="0">
                <ui:ListView x:Name="VaultListView"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             SelectionMode="Single">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource ItemTitleTextBlockStyle}" />
                                    <Border Margin="8,0,0,0"
                                            Padding="6,1"
                                            CornerRadius="9"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="置顶"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding MetaText}"
                                           Style="{StaticResource ItemCaptionTextBlockStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>

                <TextBlock Text="{Binding EmptyHint}"
                           Margin="8"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- 详情 -->
            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Border Padding="20"
                        CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- 右侧留出滚动条宽度，避免浮动的滚动条压住右侧按钮/输入框 -->
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="{Binding DetailTitle}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedItem.MetaText}"
                                       Style="{StaticResource ItemCaptionTextBlockStyle}"
                                       Margin="0,4,0,0" />

                            <Border Height="1"
                                    Margin="0,14"
                                    Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />

                            <!-- 登录地址 -->
                            <TextBlock Text="登录地址" Style="{StaticResource ItemCaptionTextBlockStyle}" />
                            <Grid Margin="0,4,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SelectedItem.Url, Mode=OneWay}"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="打开"
                                        Margin="8,0,0,0"
                                        Click="OpenUrlButton_Click" />
                                <Button Grid.Column="2"
                                        Content="复制"
                                        Margin="8,0,0,0"
                                        Click="CopyUrlButton_Click" />
                            </Grid>

                            <!-- 账号 -->
                            <TextBlock Text="账号" Style="{StaticResource ItemCaptionTextBlockStyle}" />
                            <Grid Margin="0,4,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding SelectedItem.Username, Mode=OneWay}"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="复制账号"
                                        Margin="8,0,0,0"
                                        Click="CopyUsernameButton_Click" />
                            </Grid>

                            <!-- 密码 -->
                            <TextBlock Text="密码" Style="{StaticResource ItemCaptionTextBlockStyle}" />
                            <Grid Margin="0,4,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding PasswordDisplay, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="{Binding RevealButtonText}"
                                        Margin="8,0,0,0"
                                        Width="64"
                                        Click="TogglePasswordButton_Click" />
                                <Button Grid.Column="2"
                                        Content="复制密码"
                                        Margin="8,0,0,0"
                                        Click="CopyPasswordButton_Click" />
                            </Grid>

                            <!-- 备注 -->
                            <TextBlock Text="备注" Style="{StaticResource ItemCaptionTextBlockStyle}" />
                            <TextBox Text="{Binding SelectedItem.Notes, Mode=OneWay}"
                                     Margin="0,4,0,14"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     MinHeight="72"
                                     MaxHeight="160"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />

                            <!-- 操作 -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="复制全部信息"
                                        Click="CopyAllButton_Click" />
                                <Button Content="编辑"
                                        Margin="8,0,0,0"
                                        Click="EditButton_Click" />
                                <Button Content="删除"
                                        Margin="8,0,0,0"
                                        Click="DeleteButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 未选中任何记录 -->
                <TextBlock Text="从左侧选择一条记录，右侧会显示账号、密码与备注。"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Page>
