# ===== 构建产物 =====
**/bin/
**/obj/
**/publish/

# ===== 发布交付物（按版本分目录，体积大，用打包脚本可再生成） =====
release/

# ===== WorkBuddy 内部数据：含真实服务器/密码箱/浏览历史备份，严禁入库 =====
.workbuddy/

# ===== 真实运行数据 / 凭据（%LOCALAPPDATA% 里的那套，备份副本也不能进） =====
servers.json
links.json
vault.json
history.json
users.json
settings.json
_fingerprint.json
WebView2Data/
*.pfx
*.key
*.p12

# ===== 工具目录：第三方安装包 / 日志 / 接口转储 =====
.tools/*.exe
.tools/*.log
.tools/api.json
.tools/InnoSetup6/

# ===== 探针产物：安装包 / 日志 / 截图 / 临时测试目录 =====
Probe/burn_extract/
Probe/e2e[0-9]*/
Probe/t_self/
Probe/shots/
Probe/__pycache__/
Probe/*.log
Probe/*.png
Probe/*.msi
Probe/*.exe
Probe/options_dump.txt

# ===== 通用：日志 / 数据库 / 浏览器 leveldb =====
*.log
*.db
*.db-journal
*-journal
*.leveldb/
Local Storage/
Session Storage/

# ===== Python / 编辑器 =====
__pycache__/
*.pyc
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
Thumbs.db
Desktop.ini
.DS_Store
@AutomationLog.txt
